# Required when running: uv run --env-file .env python -m rerank_eval.run llm ...
OPENAI_API_KEY=

# Required when running: uv run --env-file .env python -m rerank_eval.run clef ...
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
